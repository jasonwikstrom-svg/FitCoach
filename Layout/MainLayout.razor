@inherits LayoutComponentBase
@inject FitCoach3.Services.AppState AppState
@inject FitCoach3.Services.Interfaces.IStorageService StorageService

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var savedPlan = await StorageService.LoadWorkoutPlanAsync();
        if (savedPlan != null)
        {
            AppState.CurrentPlan = savedPlan;
        }
    }
}